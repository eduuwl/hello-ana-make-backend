// Schema Prisma — Hello Ana Make API
// Fase 1: Auth/clientes, Categorias, Marcas, Produtos (ver docs/*.md no frontend para o contrato completo).
// Demais domínios (carrinho, cupons, promoções, recompensas, frete, pedidos, pagamentos, favoritos,
// admin extra, configurações) entram em fases seguintes e vão crescer este schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  customer
  admin
}

enum BadgeType {
  new
  bestseller
  exclusive
  limited
  sale
  eco
  vegan
  custom
}

enum OrderStatus {
  pending_payment
  paid
  processing
  shipped
  in_transit
  delivered
  cancelled
  refunded
  returned
}

enum PaymentMethod {
  credit_card
  debit_card
  pix
  boleto
  wallet
  store_credit
}

enum PaymentStatus {
  pending
  processing
  authorized
  paid
  failed
  cancelled
  refunded
  partially_refunded
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  name            String
  phone           String?
  document        String?
  avatarUrl       String?
  birthDate       DateTime?
  emailVerified   Boolean   @default(false)
  acceptMarketing Boolean   @default(false)
  role            Role      @default(customer)

  // Sessão simples de refresh token (single-session). Evoluir para tabela de sessões
  // por dispositivo quando o app precisar de múltiplos refresh tokens simultâneos.
  refreshTokenHash      String?
  refreshTokenExpiresAt DateTime?

  resetPasswordTokenHash String?
  resetPasswordExpiresAt DateTime?

  // Cliente correspondente no Asaas — criado no primeiro pagamento e reaproveitado depois
  // (docs/10-pagamentos.md → gateway real). Só usado quando PAYMENT_GATEWAY=asaas.
  asaasCustomerId String?

  addresses         Address[]
  cart              Cart?
  couponRedemptions CouponRedemption[]
  orders            Order[]
  favorites         Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Address {
  id            String  @id @default(uuid())
  userId        String
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String?
  recipientName String
  street        String
  number        String
  complement    String?
  neighborhood  String
  city          String
  state         String
  zipCode       String
  country       String  @default("BR")
  phone         String?
  isDefault     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("addresses")
}

model Cart {
  id         String     @id @default(uuid())
  userId     String?    @unique
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponCode String?
  items      CartItem[]

  // Opção de frete escolhida (08-frete.md); o preço é o cotado no momento da seleção,
  // recotar tem TTL curto sugerido no doc — não implementado aqui ainda.
  shippingOptionId String?
  shippingPrice    Decimal? @db.Decimal(10, 2)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("carts")
}

model CartItem {
  id     String @id @default(uuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId   String
  productSlug String
  productName String
  variantId   String
  variantSku  String
  variantName String
  attributes  Json   @default("{}")
  image       String

  // Snapshot no momento em que o item foi adicionado (docs/04-carrinho.md).
  // Revalidado/recalculado no checkout, não a cada GET.
  unitPrice        Decimal  @db.Decimal(10, 2)
  promotionalPrice Decimal? @db.Decimal(10, 2)
  quantity         Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
  @@map("cart_items")
}

enum CouponType {
  percentage
  fixed_amount
  free_shipping
  category
  product
}

model Coupon {
  id                String     @id @default(uuid())
  code              String     @unique
  type              CouponType
  value             Decimal    @db.Decimal(10, 2)
  description       String?
  categoryIds       String[]   @default([])
  productIds        String[]   @default([])
  minOrderValue     Decimal?   @db.Decimal(10, 2)
  maxDiscountValue  Decimal?   @db.Decimal(10, 2)
  usageLimit        Int?
  usageCount        Int        @default(0)
  perUserLimit      Int?
  firstPurchaseOnly Boolean    @default(false)
  startsAt          DateTime
  endsAt            DateTime
  isActive          Boolean    @default(true)

  redemptions CouponRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("coupons")
}

// Registrado quando um pedido pago consome o cupom (docs/05-cupons.md → "Consumo do uso").
model CouponRedemption {
  id       String  @id @default(uuid())
  couponId String
  coupon   Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId  String?

  createdAt DateTime @default(now())

  @@map("coupon_redemptions")
}

model Category {
  id          String  @id @default(uuid())
  slug        String  @unique
  name        String
  description String  @default("")
  image       String  @default("")
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Brand {
  id          String  @id @default(uuid())
  slug        String  @unique
  name        String
  description String?
  logo        String?
  website     String?
  isActive    Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brands")
}

model Product {
  id               String   @id @default(uuid())
  slug             String   @unique
  name             String
  shortDescription String   @default("")
  description      String   @default("")
  ingredients      String?
  howToUse         String?
  benefits         String[] @default([])
  technicalInfo    Json?

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Restrict)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  images    ProductImage[]
  variants  ProductVariant[]
  badges    ProductBadge[]
  favorites Favorite[]

  ratingAverage Decimal @default(0) @db.Decimal(2, 1)
  ratingCount   Int     @default(0)

  isFeatured   Boolean @default(false)
  isNew        Boolean @default(false)
  isBestseller Boolean @default(false)
  isActive     Boolean @default(true)

  // Agregados desnormalizados a partir de `variants`, recalculados a cada create/update
  // de produto (ver products.service.ts#recomputeAggregates). Evita joins/SQL bruto para
  // ordenar e filtrar por preço/estoque na listagem pública.
  totalStock        Int     @default(0)
  minEffectivePrice Decimal @default(0) @db.Decimal(10, 2)
  maxEffectivePrice Decimal @default(0) @db.Decimal(10, 2)
  hasPromotion      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  @@map("product_images")
}

model ProductVariant {
  id               String   @id @default(uuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku              String   @unique
  name             String
  attributes       Json     @default("{}")
  price            Decimal  @db.Decimal(10, 2)
  promotionalPrice Decimal? @db.Decimal(10, 2)
  stock            Int      @default(0)
  image            String?
  isAvailable      Boolean  @default(true)

  @@map("product_variants")
}

model ProductBadge {
  id        String    @id @default(uuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  type      BadgeType
  color     String?

  @@map("product_badges")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("favorites")
}

// docs/07-recompensas.md → brinde progressivo por valor elegível do carrinho.
model RewardTier {
  id                String   @id @default(uuid())
  minimumAmount     Decimal  @db.Decimal(10, 2)
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  rewardName        String
  rewardDescription String   @default("")
  rewardImage       String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reward_tiers")
}

enum PromotionType {
  direct_discount
  buy_x_get_y
  progressive
  flash_sale
  kit
  campaign
}

// docs/06-promocoes.md → campanhas de catálogo/carrinho, distintas de cupons.
model Promotion {
  id                 String        @id @default(uuid())
  slug               String        @unique
  name               String
  description        String        @default("")
  type               PromotionType
  discountPercentage Decimal?      @db.Decimal(5, 2)
  discountAmount     Decimal?      @db.Decimal(10, 2)
  buyXGetY           Json?
  progressiveTiers   Json?
  kitItems           Json?
  kitPrice           Decimal?      @db.Decimal(10, 2)
  productIds         String[]      @default([])
  categoryIds        String[]      @default([])
  brandIds           String[]      @default([])
  bannerImage        String?
  startsAt           DateTime
  endsAt             DateTime
  isActive           Boolean       @default(true)
  priority           Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("promotions")
}

// docs/15-configuracoes.md → single-tenant, um único registro "singleton".
model StoreSettings {
  id        String   @id @default("singleton")
  data      Json
  updatedAt DateTime @updatedAt

  @@map("store_settings")
}

// Contador atômico por ano para gerar `Order.orderNumber` (HA-YYYY-####) sem race condition
// (upsert com increment dentro da mesma transaction que cria o pedido — docs/09-checkout-pedidos.md).
model OrderCounter {
  year  Int @id
  value Int @default(0)

  @@map("order_counters")
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status      OrderStatus @default(pending_payment)

  items OrderItem[]

  subtotal Decimal @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  shipping Decimal @default(0) @db.Decimal(10, 2)
  tax      Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)
  currency String  @default("BRL")

  couponCode String?

  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(pending)
  // Referência de conveniência ao Payment ativo/mais recente — um pedido pode ter várias
  // tentativas de pagamento (docs/10-pagamentos.md → "pagamento duplicado"), por isso não é FK.
  paymentId     String?

  shippingOptionId String?

  // Snapshot imutável do endereço no momento do pedido (não FK para Address, que pode mudar/ser
  // apagado depois) — mesmo shape de AddressResponse.
  shippingAddress Json
  billingAddress  Json?

  trackingCode String?
  trackingUrl  String?
  notes        String?

  // Snapshot do brinde conquistado no momento do pedido (docs/07-recompensas.md → "No pedido").
  rewardTierId      String?
  rewardName        String?
  rewardDescription String?
  rewardImage       String?

  // Evita pedido duplicado em retry de rede (docs/09-checkout-pedidos.md → Idempotency-Key).
  idempotencyKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  Payment     Payment[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId   String
  productSlug String
  productName String
  variantId   String
  variantSku  String
  variantName String
  attributes  Json   @default("{}")
  image       String

  unitPrice        Decimal  @db.Decimal(10, 2)
  promotionalPrice Decimal? @db.Decimal(10, 2)
  quantity         Int
  lineTotal        Decimal  @db.Decimal(10, 2)

  @@map("order_items")
}

model Payment {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method PaymentMethod
  status PaymentStatus @default(pending)

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("BRL")

  pixQrCode    String?
  pixQrCodeUrl String?
  pixExpiresAt DateTime?

  boletoUrl     String?
  boletoBarcode String?

  redirectUrl String?

  cardBrand          String?
  cardLastFourDigits String?
  installments       Int?

  // Idempotência de webhook (docs/10-pagamentos.md → "webhook fora de ordem: idempotente por transactionId").
  transactionId String? @unique

  failureReason  String?
  refundedAmount Decimal? @db.Decimal(10, 2)
  metadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorizedAt DateTime?
  paidAt       DateTime?
  failedAt     DateTime?
  cancelledAt  DateTime?
  refundedAt   DateTime?

  @@index([orderId])
  @@map("payments")
}
