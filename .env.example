# Connection string do Neon (Postgres). Pegue em https://console.neon.tech/ > seu projeto > Connection Details.
# Use a connection "pooled" para a app e a "direct" (sem -pooler) para rodar migrations, se o Neon separar as duas.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.sa-east-1.aws.neon.tech/hello_ana_make?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.sa-east-1.aws.neon.tech/hello_ana_make?sslmode=require"

PORT=8000

# Segredos JWT — gere valores fortes e únicos em produção (ex.: openssl rand -hex 32)
JWT_ACCESS_SECRET="troque-este-segredo-de-access-token"
JWT_ACCESS_EXPIRES_IN="30m"
JWT_REFRESH_SECRET="troque-este-segredo-de-refresh-token"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS — origem do frontend Next.js
CORS_ORIGIN="http://localhost:3000"

# Cupom de boas-vindas: agora mora em StoreSettings.signupPromotion (tabela store_settings,
# GET/PUT /api/v1/admin/settings) em vez de env var — editável pelo admin sem redeploy.

# Pagamentos (10-pagamentos.md). PAYMENT_WEBHOOK_SECRET é comparado ao header
# X-Webhook-Secret (mock) ou ao "asaas-access-token" que o Asaas manda em todo webhook —
# use o MESMO valor que você configurar como "Token de autenticação" no painel do Asaas.
PAYMENT_WEBHOOK_SECRET="troque-este-segredo-de-webhook"

# Gateway ativo ("mock" ou "asaas") e a API key ficam em StoreSettings.integrations
# (tabela store_settings), editáveis via PATCH /api/v1/admin/settings/integrations —
# não aqui. ASAAS_API_URL fica em env por ser infra (sandbox x produção), não um
# toggle de negócio; pegue a chave em https://sandbox.asaas.com (testes) ou
# https://asaas.com (produção), em Configurações > Integrações > API.
ASAAS_API_URL="https://api-sandbox.asaas.com/v3"
