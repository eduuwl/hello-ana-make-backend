# Connection string do Neon (Postgres). Pegue em https://console.neon.tech/ > seu projeto > Connection Details.
# Use a connection "pooled" para a app e a "direct" (sem -pooler) para rodar migrations, se o Neon separar as duas.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.sa-east-1.aws.neon.tech/hello_ana_make?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.sa-east-1.aws.neon.tech/hello_ana_make?sslmode=require"

PORT=8000

# Segredos JWT — gere valores fortes e únicos em produção (ex.: openssl rand -hex 32)
JWT_ACCESS_SECRET="troque-este-segredo-de-access-token"
JWT_ACCESS_EXPIRES_IN="30m"
JWT_REFRESH_SECRET="troque-este-segredo-de-refresh-token"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS — origem do frontend Next.js
CORS_ORIGIN="http://localhost:3000"

# Cupom de boas-vindas (10-checkout / 11-auth-clientes)
SIGNUP_PROMOTION_ENABLED=true
SIGNUP_PROMOTION_COUPON_CODE="BEMVINDA10"
SIGNUP_PROMOTION_DISCOUNT_PERCENTAGE=10

# Pagamentos (10-pagamentos.md) — "mock" (padrão, sem credenciais) ou "asaas".
# PAYMENT_WEBHOOK_SECRET é comparado ao header X-Webhook-Secret (mock) ou ao
# "asaas-access-token" que o Asaas manda em todo webhook — use o MESMO valor que você
# configurar como "Token de autenticação" ao criar o webhook no painel do Asaas.
PAYMENT_GATEWAY=mock
PAYMENT_WEBHOOK_SECRET="troque-este-segredo-de-webhook"

# Só necessário com PAYMENT_GATEWAY=asaas — pegue a API key em
# https://sandbox.asaas.com (ambiente de testes) ou https://asaas.com (produção),
# em Configurações > Integrações > API. Sandbox e produção usam base URLs diferentes.
ASAAS_API_KEY=""
ASAAS_API_URL="https://api-sandbox.asaas.com/v3"
